generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  nickname      String   @unique
  password      String?

  authProvider  AuthProvider @default(EMAIL)
  googleId      String?      @unique
  googleEmail   String?
  profileImage  String?

  refreshToken  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedRooms    StudyRoom[]      @relation("RoomOwner")
  joinedRooms   StudyRoomMember[]

  sentMessages  ChatMessage[]

  @@index([email])
  @@index([nickname])
  @@index([googleId])
}

model StudyRoom {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  roomType    RoomType
  maxMembers  Int

  inviteCode  String   @unique @default(cuid())

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     Int
  owner       User     @relation("RoomOwner", fields: [ownerId], references: [id])

  members     StudyRoomMember[]
  messages    ChatMessage[]

  isDeleted   Boolean  @default(false)
  deletedAt   DateTime? @db.Timestamp(6)

  @@index([inviteCode])
  @@index([ownerId])
  @@index([isDeleted])
}

model StudyRoomMember {
  id        Int         @id @default(autoincrement())
  role      MemberRole  @default(MEMBER)
  joinedAt  DateTime    @default(now())

  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId    Int
  room      StudyRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
}

model ChatMessage {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text
  isDeleted   Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt


  senderId    Int
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  studyRoomId Int
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)

  @@index([studyRoomId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([isDeleted])
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum RoomType {
  SMALL
  LARGE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}